# Railway backend variables template.
# Replace every PASTE_* value in Railway Variables.
# Never commit real tokens or API keys to GitHub.

PORT=3000
HOST=0.0.0.0

# Used only for config-file imports and automatic update notifications.
BUILDER_BOT_TELEGRAM_TOKEN=PASTE_TELEGRAM_BOT_TOKEN

# Keep this identical to the Builder Bot BUILDER_BACKEND_API_KEY.
BUILDER_BACKEND_API_KEY=PASTE_SHARED_BACKEND_API_KEY

BUILDER_SOURCE_REPO=instaboosterwesd/rgxpanel.in
BUILDER_SOURCE_BRANCH=main
BUILDER_GITHUB_SOURCE_TOKEN=PASTE_GITHUB_SOURCE_TOKEN
BUILDER_GITHUB_TARGET_TOKEN=PASTE_GITHUB_TARGET_TOKEN

BUILDER_VERCEL_TOKEN=PASTE_VERCEL_TOKEN
BUILDER_VERCEL_TEAM_ID=
BUILDER_VERCEL_PROJECT_ID=

# TeleBotHost startup URL sync.
BUILDER_TELEBOTHOST_API_KEY=PASTE_TELEBOTHOST_SECRET_KEY
BUILDER_TELEBOTHOST_BOT_ID=377965775095836
BUILDER_TELEBOTHOST_ENV_NAME=BUILDER_BACKEND_URL
BUILDER_TELEBOTHOST_API_BASE=https://api.telebothost.com/api/v1

# Public GitHub discovery fallback.
BUILDER_BACKEND_REPO=reversebypass7830-bot/telegram-builder-bot-backend
BUILDER_BACKEND_DISCOVERY_FILE=backend-endpoint.json
# Leave blank on Railway; RAILWAY_PUBLIC_DOMAIN is detected automatically.
BACKEND_PUBLIC_URL=