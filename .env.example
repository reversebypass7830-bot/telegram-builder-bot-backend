PORT=3000

# Shared secret used by TeleBotHost TBL commands.
BUILDER_BACKEND_API_KEY=

# Private source project and GitHub credentials.
BUILDER_SOURCE_REPO=instaboosterwesd/rgxpanel.in
BUILDER_SOURCE_BRANCH=main
BUILDER_GITHUB_SOURCE_TOKEN=
BUILDER_GITHUB_TARGET_TOKEN=

# Optional Vercel deployment settings.
BUILDER_VERCEL_TOKEN=
BUILDER_VERCEL_TEAM_ID=
BUILDER_VERCEL_PROJECT_ID=

# TeleBotHost startup URL sync.
BUILDER_TELEBOTHOST_API_KEY=
BUILDER_TELEBOTHOST_BOT_ID=377965775095836
BUILDER_TELEBOTHOST_ENV_NAME=BUILDER_BACKEND_URL
BUILDER_TELEBOTHOST_API_BASE=https://api.telebothost.com/api/v1

# Public GitHub repository used for endpoint discovery.
BUILDER_BACKEND_REPO=reversebypass7830-bot/telegram-builder-bot-backend
BUILDER_BACKEND_DISCOVERY_FILE=backend-endpoint.json
# Optional override; otherwise Railway/host-provided public variables are detected.
BACKEND_PUBLIC_URL=